# Copiá estos nombres en Vercel > Project > Settings > Environment Variables.
# No pongas valores reales en este archivo.

# --- Interruptor ---
BOT_ENABLED=false                 # true para que el bot responda

# --- Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- MongoDB ---
TIXPAYS_MONGODB_URI=              # usuario de Atlas con rol SOLO LECTURA ("read")
TIXPAYS_DB=                       # nombre de la base de TixPays (si no está en la URI)
BOT_MONGODB_URI=                  # usuario con lectura/escritura SOLO sobre la base del bot
BOT_DB=tixy_bot

# --- Meta ---
META_VERIFY_TOKEN=                # texto inventado; el mismo va en Meta
META_APP_SECRET=                  # App Manager Tix > Configuración > Básica
META_GRAPH_VERSION=v26.0

# --- WhatsApp ---
WHATSAPP_ACCESS_TOKEN=            # token permanente del usuario del sistema tixpays-bot
WHATSAPP_PHONE_NUMBER_ID=1407827092409739

# --- Instagram ---
IG_ACCESS_TOKEN=
IG_APP_SECRET=
IG_COMMENT_KEYWORDS=ENTRADA,ENTRADAS,INFO,DEMO
IG_COMMENT_REPLY=

# --- Comercial / links ---
FRONT_URL=https://tixpays.com
EVENT_URL_TEMPLATE=/eventos/{org}/{event}
DEMO_URL=
OWNER_WHATSAPP=
LEAD_MIN_A=1500
LEAD_MIN_B=300
